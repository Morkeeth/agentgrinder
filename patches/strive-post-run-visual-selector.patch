+"""The post-run visual selector is one rule list and one fixed night packet."""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+from agentgrinder.outcome import NOTHING_SHIPPED
+from agentgrinder.visual_select import render_visual_card, select_visual, trace_report
+
+ROOT = Path(__file__).resolve().parents[1]
+NIGHT = ROOT / "tests" / "fixtures" / "full-night-run-code-route.json"
+ORDER = (
+    "turning-point-trail",
+    "fleet-relay",
+    "loopback-seismograph",
+    "code-topography",
+    "project-terrain",
+    "activity-river",
+    "tool-constellation",
+    "context-weather",
+    "verification-ascent",
+    "proof-funnel",
+)
+
+
+def night():
+    return json.loads(NIGHT.read_text(encoding="utf-8"))
+
+
+def test_fixed_night_packet_selects_fleet_relay_and_nothing_else():
+    run = night()
+    card = select_visual(run)
+    assert card.visual_id == "fleet-relay"
+    assert card.label == "Fleet Relay"
+    assert card.result == "STRIVE draws a live four-project Code Route"
+    assert [fact.text for fact in card.facts] == ["4 projects", "3 handoffs", "9 stops"]
+    assert [fact.source for fact in card.facts] == [
+        "code_route.projects in stop order",
+        "code_route.connectors kind=handoff",
+        "code_route.stops",
+    ]
+    assert card.geometry[:4] == ("zup", "agentgrinder-public", "mountain-of-helicon", "fleet-ops")
+    assert card.geometry[4:] == (
+        ("zup", "agentgrinder-public"),
+        ("agentgrinder-public", "mountain-of-helicon"),
+        ("mountain-of-helicon", "fleet-ops"),
+    )
+    html = render_visual_card(run)
+    assert html == render_visual_card(json.loads(json.dumps(run)))
+    assert html.count("<svg") == 1
+    assert 'data-visual="fleet-relay"' in html
+    assert ">Inspect run<" in html
+    assert 'href="#inspect-run"' in html
+    assert "https://" not in html
+    assert run["artifact_url"] not in html
+    assert "#0047ff" in html and "background:#fff" in html
+    assert "score" not in html.lower()
+    report = {row.visual_id: row for row in trace_report(run)}
+    assert [row.visual_id for row in trace_report(run)] == list(ORDER)
+    assert report["fleet-relay"].selected and report["fleet-relay"].present == ("code_route",)
+    assert report["proof-funnel"].present == ("shipped", "receipts") and not report["proof-funnel"].selected
+    assert report["turning-point-trail"].absent == ("failed_check_ids_before", "passed_check_ids_after")
+    assert report["loopback-seismograph"].absent == ("check_outcomes",)
+    assert "check_outcomes" in report["loopback-seismograph"].collector
+    assert report["verification-ascent"].absent == ("claims", "claims_verified")
+    assert report["tool-constellation"].absent == ("tool_calls_by_category",)
+    assert report["context-weather"].absent == (
+        "web_searches", "context_reads", "index_reads", "memory_reads",
+    )
+    assert report["project-terrain"].absent == ("route",)
+    assert report["activity-river"].absent == ("ridge", "ridge_basis")
+
+
+def test_each_named_visual_has_one_exact_predicate():
+    trail = select_visual({
+        "failed_check_ids_before": ["mobile-card", "privacy"],
+        "passed_check_ids_after": ["privacy", "mobile-card"],
+    })
+    assert trail.visual_id == "turning-point-trail"
+    assert trail.geometry == (2, 2, 2)
+    assert "not on this run" in trail.limitation
+
+    pulses = select_visual({"check_outcomes": ["fail", "pass", "fail"]})
+    assert pulses.visual_id == "loopback-seismograph"
+    assert select_visual({"retries": 4, "failed_attempts": 4}).visual_id == "unmapped"
+
+    ascent = select_visual({"claims": 9, "claims_verified": 6})
+    assert ascent.visual_id == "verification-ascent"
+    assert ascent.geometry == (9, 6)
+    assert len(ascent.facts) == 2
+
+    funnel = select_visual({
+        "shipped": ["One result"],
+        "receipts": [{"label": "Proof", "url": "https://example.com/proof"}],
+    })
+    assert funnel.visual_id == "proof-funnel"
+    assert funnel.geometry == (1, 1)
+    assert "https://example.com/proof" not in render_visual_card({
+        "shipped": ["One result"],
+        "receipts": [{"label": "Proof", "url": "https://example.com/proof"}],
+    })
+
+    tools = select_visual({
+        "tool_calls": 100,
+        "tool_calls_by_category": {"files": 40, "shell": 29, "tests": 31},
+    })
+    assert tools.visual_id == "tool-constellation"
+    assert tools.facts[0].text == "files 40"
+    assert select_visual({
+        "tool_calls": 90,
+        "tool_calls_by_category": {"files": 40, "shell": 29},
+    }).visual_id == "unmapped"
+
+    weather = select_visual({"web_searches": 3, "context_reads": 8, "index_reads": 0})
+    assert weather.visual_id == "context-weather"
+    assert [fact.text for fact in weather.facts] == [
+        "8 context_reads", "3 web_searches", "0 index_reads",
+    ]
+    assert select_visual({"web_searches": 3}).visual_id == "unmapped"
+
+    route = {
+        "v": 1,
+        "projects": [{"id": "strive", "label": "strive", "basis": "measured"}],
+        "stops": [
+            {"id": "edit-1", "project": "strive", "kind": "edit", "label": "Edit card", "basis": "measured"},
+            {"id": "check-1", "project": "strive", "kind": "check", "label": "Checks passed", "basis": "measured"},
+        ],
+        "connectors": [],
+        "finish": {"stop": "check-1", "kind": "artifact", "label": "Card holds"},
+    }
+    topo = select_visual({
+        "code_route": route,
+        "shipped": ["One result"],
+        "receipts": [{"label": "Proof", "url": "https://example.com/proof"}],
+    })
+    assert topo.visual_id == "code-topography"
+    assert topo.geometry == ("edit", "check")
+
+    terrain = select_visual({"route": [8, 8, 3, 3, 8, 11], "route_legend": ["/Users/private/session"], "files_touched": 12})
+    assert terrain.visual_id == "project-terrain"
+    assert terrain.geometry == (8, 3, 8, 11)
+    assert "/Users/" not in render_visual_card({"route": [8, 8, 3, 11], "route_legend": ["/Users/private/session"]})
+
+    river = select_visual({
+        "ridge": [0, 4, 8, 2] * 12 + [1, 1],
+        "ridge_basis": "wall-time",
+        "commit_bins": [1, 4],
+    })
+    assert river.visual_id == "activity-river"
+    assert river.facts[1].text == "equal wall-time bins"
+    assert river.facts[2].text == "2 commit marks"
+
+
+def test_earlier_rules_keep_a_richer_packet_to_one_visual():
+    both = night()
+    both["failed_check_ids_before"] = ["privacy"]
+    both["passed_check_ids_after"] = ["privacy"]
+    both["ridge"] = [1] * 50
+    both["ridge_basis"] = "turn-order"
+    both["claims"] = 4
+    both["claims_verified"] = 2
+    assert select_visual(both).visual_id == "turning-point-trail"
+
+    no_handoff = night()
+    no_handoff["code_route"] = dict(no_handoff["code_route"])
+    no_handoff["code_route"]["connectors"] = []
+    assert select_visual(no_handoff).visual_id == "proof-funnel"
+
+
+def test_empty_run_uses_the_baseline_and_does_not_invent_a_result():
+    card = select_visual({})
+    assert card.visual_id == "unmapped"
+    assert card.result == NOTHING_SHIPPED
+    assert card.facts == ()
+    html = render_visual_card({})
+    assert html.count("<svg") == 1
+    assert "not a measurement" in html
+    assert ">Inspect run<" in html
+
+
+def test_visual_command_writes_a_local_card_and_does_not_open_or_publish(tmp_path, monkeypatch):
+    out = tmp_path / "visual.html"
+    opened = []
+    from agentgrinder import cli
+    monkeypatch.setattr(cli._BROWSER, "open", opened.append)
+    assert cli.main(["visual", str(NIGHT), "-o", str(out)]) == 0
+    html = out.read_text(encoding="utf-8")
+    assert "Fleet Relay" in html and "Inspect run" in html
+    assert opened == []
+    result = subprocess.run(
+        [sys.executable, "-m", "agentgrinder", "visual", str(NIGHT), "-o", str(out)],
+        cwd=ROOT, capture_output=True, text=True, check=True,
+    )
+    assert "not published" in result.stdout
+    assert "http" not in result.stdout
